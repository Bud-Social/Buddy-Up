# ── Database ──────────────────────────────────────────────────────────
DB_NAME=buddyup
DB_USER=buddyup
DB_PASSWORD=changeme

# ── Django ────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=buddyup.app,api.buddyup.app
CORS_ALLOWED_ORIGINS=https://buddyup.app
CSRF_TRUSTED_ORIGINS=https://buddyup.app,https://api.buddyup.app

# ── Social auth (Google sign-in, backend OAuth) ───────────────────────
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx

# ── Sign in with Apple ────────────────────────────────────────────────
APPLE_CLIENT_ID=xxxxx
APPLE_TEAM_ID=xxxxx
APPLE_KEY_ID=xxxxx
# Raw PKCS#8 contents of the .p8 key (newlines escaped as \n)
APPLE_PRIVATE_KEY=

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme

# ── Cloudinary ────────────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Email ─────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxx

# ── SMS / M-Pesa ──────────────────────────────────────────────────────
AFRICASTALKING_USERNAME=buddyup
AFRICASTALKING_API_KEY=atsk_xxxxx
MPESA_CONSUMER_KEY=xxxxx
MPESA_CONSUMER_SECRET=xxxxx
MPESA_SHORTCODE=174379
MPESA_PASSKEY=xxxxx
MPESA_CALLBACK_URL=https://api.buddyup.app/api/v1/payments/mpesa/callback/

# ── Payments ──────────────────────────────────────────────────────────
# Legacy/unused by default — Flutterwave is the active payment provider.
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_xxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_xxxxx
FLUTTERWAVE_ENCRYPTION_KEY=xxxxx
FLUTTERWAVE_WEBHOOK_HASH=replace-with-random-webhook-hash
KES_PER_USD=129.5

# ── Live Streaming ────────────────────────────────────────────────────
LIVEKIT_URL=wss://rtc.buddyup.app
LIVEKIT_INTERNAL_URL=http://livekit:7880
LIVEKIT_TURN_DOMAIN=turn.buddyup.app
LIVEKIT_API_KEY=replace-with-a-random-api-key
LIVEKIT_API_SECRET=replace-with-a-long-random-secret
MINIO_ROOT_USER=buddyup-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-password
LIVE_RECORDING_S3_ENDPOINT=http://minio:9000
LIVE_RECORDING_S3_BUCKET=buddyup-replays
LIVE_REPLAY_BASE_URL=https://buddyup.app/replays

# ── AI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4o
# Backend → AI microservice connection
AI_SERVICE_URL=http://ai-service:8003
AI_API_KEY=replace-with-a-random-ai-api-key
# Local model cache dirs (mounted as the ai_models volume in compose)
AI_MODEL_CACHE_DIR=/models
AI_HF_HOME=/models/hf
HF_TOKEN=hf_xxxxx

# ── Legacy / unused by default ────────────────────────────────────────
# Agora RTC (LiveKit is the default RTC provider), Mux (self-hosted
# replay storage is the default) and S3 message attachments
# (Cloudinary/local storage is the default) are only used if the
# corresponding feature is explicitly enabled.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MESSAGING_S3_ENDPOINT=
MESSAGING_S3_BUCKET=
MESSAGING_S3_ACCESS_KEY=
MESSAGING_S3_SECRET_KEY=

# ── AWS (Content Moderation) ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_DEFAULT_REGION=us-east-1

# ── Firebase (Push Notifications) ────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Web push (FCM HTTP v1 + VAPID)
FCM_SERVER_KEY=xxxxx
FCM_PROJECT_ID=buddyup
VAPID_PUBLIC_KEY=xxxxx
VAPID_PRIVATE_KEY=xxxxx
VAPID_CLAIM_EMAIL=mailto:ops@buddyup.app

# ── KYC ───────────────────────────────────────────────────────────────
SMILE_IDENTITY_API_KEY=xxxxx
SMILE_IDENTITY_PARTNER_ID=xxxxx
# ID+selfie face match: auto (AWS Rekognition when AWS creds present) | manual
FACE_MATCH_BACKEND=auto
VERIFICATION_DOCUMENT_RETENTION_DAYS=90
VERIFICATION_POST_REVIEW_RETENTION_DAYS=30

# ── Monitoring ────────────────────────────────────────────────────────
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
# Release marker shown by readiness checks and metrics scrape protection.
RELEASE_VERSION=local
RELEASE_COMMIT=local
METRICS_TOKEN=

# ── Frontend (Vite — prefix VITE_ for client exposure) ───────────────
VITE_API_BASE_URL=https://api.buddyup.app/api/v1
VITE_WS_BASE_URL=wss://api.buddyup.app
# Legacy/unused by default — LiveKit is the default RTC provider.
VITE_AGORA_APP_ID=xxxxx
VITE_LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
VITE_GOOGLE_MAPS_KEY=xxxxx
VITE_CLOUDINARY_CLOUD_NAME=xxxxx
VITE_FIREBASE_CONFIG={"apiKey":"...","projectId":"...",...}

# ── Media serving (local-storage fallback) ─────────────────────────────
# When Cloudinary is not configured, uploads are stored on the API server
# and served at {PUBLIC_API_URL}/media/. Set this to the public API origin
# so clients receive absolute URLs (a relative /media/... would resolve
# against the frontend domain and 404).
PUBLIC_API_URL=

# ── WebAuthn passkeys ──────────────────────────────────────────────────
# RP ID must be the site domain the passkey is created on; ORIGIN must be
# the full scheme+host the browser sees. Defaults: buddyup.app /
# https://buddyup.app
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# ── Email branding ─────────────────────────────────────────────────────
# Absolute URL of the logo rendered in transactional emails, and the
# frontend origin used for links.
EMAIL_LOGO_URL=
PUBLIC_FRONTEND_URL=https://buddyup.app
