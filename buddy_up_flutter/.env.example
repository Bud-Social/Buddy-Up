# BuddyUp Flutter environment
# -----------------------------
# Copy this file to `.env` (or override values in `.env.local`) before running.
#
# The app routes to cloud (production) URLs by default. For LOCAL development
# against the docker-compose stack, set APP_ENV=local at build/run time:
#
#   flutter run --dart-define=APP_ENV=local
#
# Or put the local URLs directly in `.env.local` (takes precedence over `.env`).

# ── API / WebSocket ────────────────────────────────────────────────────
# Production (cloud) — backend.buddyupfit.com
API_BASE_URL=https://backend.buddyupfit.com/api/v1
WS_BASE_URL=wss://backend.buddyupfit.com

# Local docker-compose stack
# API_BASE_URL=http://localhost:8002/api/v1
# WS_BASE_URL=ws://localhost:8002

# ── Real-time / media ──────────────────────────────────────────────────
AGORA_APP_ID=
# Local LiveKit: ws://localhost:7880 — Production: wss://rtc.buddyup.app
LIVEKIT_URL=
# Leave empty in production to use the BuddyUp-operated rtc.buddyup.app endpoint.
REALTIME_TRANSPORT=livekit

# ── Integrations ───────────────────────────────────────────────────────
GOOGLE_MAPS_KEY=
# Web client id (OAuth "Web application" client) — audience of the Google
# ID token the backend verifies (GOOGLE_CLIENT_ID on the backend). Required
# for Google sign-in on Android unless google-services.json ships with the
# build. See README.
GOOGLE_SERVER_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
FIREBASE_CONFIG=

# ── Fund Us / support links (optional; blank hides the action) ─────────
# Mirrors the web VITE_FUNDRAISER_URL etc. Blank values render the
# "coming soon" state, exactly like the web build.
FUNDRAISER_URL=
PLEDGE_FORM_URL=
PARTNERSHIP_FORM_URL=
INVESTOR_FORM_URL=
