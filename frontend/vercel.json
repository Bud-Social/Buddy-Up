{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), payment=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/((?!$|about$|help$|terms$|privacy$|community-guidelines$|cookie-policy$|medical-disclaimer$|sponsorship-policy$|adult-content-policy$|robots.txt$|sitemap.xml$|llms.txt$|manifest.webmanifest$|icons/.*|favicon-.*|logo-.*|sw.js$|offline.html$|service-worker-push.js$|assets/.*).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}

